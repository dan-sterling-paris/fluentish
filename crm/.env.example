# ── Google Sheets ─────────────────────────────────────────────────────────────
# Absolute path to your downloaded service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service_account.json

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the tab inside the sheet (default: Sheet1)
SHEET_NAME=Sheet1

# Column positions (1=A, 2=B, 3=C …)
SHEET_NAME_COL=1
SHEET_PHONE_COL=2
SHEET_STATUS_COL=3

# Value written back to the status column to mark a row as processed
INGESTED_MARKER=Ingested

# ── ClickSend ─────────────────────────────────────────────────────────────────
# Your ClickSend account email address
CLICKSEND_USERNAME=your_email@example.com

# Found at: https://dashboard.clicksend.com/account/subaccount
CLICKSEND_API_KEY=your_clicksend_api_key

# The Sender ID or virtual number shown to recipients (max 11 chars for alpha)
CLICKSEND_FROM=FluentISH

# Optional: a secret token appended to your webhook URL (?secret=XXX)
# Set this in both your .env and in the ClickSend webhook URL config
CLICKSEND_WEBHOOK_SECRET=

# ── SMS Templates ─────────────────────────────────────────────────────────────
# {name} is replaced with the lead's name at send time
TEMPLATE_1=Hi {name}, thanks for your interest in French lessons! Are you looking for in-person or online classes?
TEMPLATE_2=Hi {name}, just checking in — have you had a chance to think about your French learning goals?
TEMPLATE_3=Hi {name}, I have some availability this week if you'd like to book a free 15-minute discovery call!

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./crm.db
PORT=8001
